# Supabase — copy to .env.local and fill from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin login (create with: npm run seed:admin)
# Email: admin@citychannel.in

# Public site URL for SEO (canonical, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Firebase Cloud Messaging (server — service account JSON from Firebase Console)
FIREBASE_PROJECT_ID=city-channel-nextjs
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@city-channel-nextjs.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
